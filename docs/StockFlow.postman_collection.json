{
  "info": {
    "name": "StockFlow Order and Inventory API",
    "description": "Requests for the local Express API. Sign in with the Login request first; its test script stores the JWT in the accessToken collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "productId", "value": "1" },
    { "key": "customerId", "value": "1" },
    { "key": "orderId", "value": "1" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Login",
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "if (pm.response.code === 200) {",
            "  const body = pm.response.json();",
            "  pm.collectionVariables.set('accessToken', body.data.accessToken);",
            "}"
          ]
        }
      }],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"replace-with-your-admin-password\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Current user",
      "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
    },
    {
      "name": "Health",
      "request": { "method": "GET", "url": "http://localhost:5000/health" }
    },
    {
      "name": "List products",
      "request": { "method": "GET", "url": "{{baseUrl}}/products?search=mouse&status=active&page=1&limit=10" }
    },
    {
      "name": "List customers",
      "request": { "method": "GET", "url": "{{baseUrl}}/customers?search=example&page=1&limit=10" }
    },
    {
      "name": "Inventory summary",
      "request": { "method": "GET", "url": "{{baseUrl}}/inventory?page=1&limit=10" }
    },
    {
      "name": "Product movement history",
      "request": { "method": "GET", "url": "{{baseUrl}}/inventory/{{productId}}/history" }
    },
    {
      "name": "List orders",
      "request": { "method": "GET", "url": "{{baseUrl}}/orders?status=all&page=1&limit=10" }
    },
    {
      "name": "Get order",
      "request": { "method": "GET", "url": "{{baseUrl}}/orders/{{orderId}}" }
    },
    {
      "name": "Create order",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": {{customerId}},\n  \"items\": [{ \"productId\": {{productId}}, \"quantity\": 1 }]\n}"
        },
        "url": "{{baseUrl}}/orders"
      }
    },
    {
        "name": "List team accounts (Admin)",
        "request": { "method": "GET", "url": "{{baseUrl}}/users?page=1&limit=10" }
    }
  ]
}
