PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stockflow_db
DB_USER=root
DB_PASSWORD=your_mysql_password
# Set true for TLS-protected managed MySQL. For certificate verification, set DB_CA_CERT to its PEM contents.
DB_SSL=false
DB_CA_CERT=
JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_EXPIRES_IN=8h
